{
  "name": "@tmaize/ks",
  "version": "0.0.0",
  "description": "koa server",
  "main": "./lib/index.js",
  "types": "./esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./esm/index.d.ts",
      "import": "./esm/index.js",
      "require": "./lib/index.js"
    },
    "./config": {
      "types": "./esm/config.d.ts",
      "import": "./esm/config.js",
      "require": "./lib/config.js"
    },
    "./util": {
      "types": "./esm/util.d.ts",
      "import": "./esm/util.js",
      "require": "./lib/util.js"
    },
    "./service": {
      "types": "./esm/service.d.ts",
      "import": "./esm/service.js",
      "require": "./lib/service.js"
    },
    "./mongo": {
      "types": "./esm/mongo.d.ts",
      "import": "./esm/mongo.js",
      "require": "./lib/mongo.js"
    }
  },
  "scripts": {
    "dev": "tsx watch example/index.ts --config=example/config.yml",
    "build": "npm run build:esm && npm run build:commonjs",
    "build:esm": "rm -rf esm && tsc",
    "build:commonjs": "rm -rf lib && tsc --outDir lib --module commonjs"
  },
  "keywords": [],
  "files": [
    "esm",
    "lib",
    "README.md"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": "https://github.com/TMaize/ks.git",
  "author": "TMaize <1772314831@qq.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "16.18.3",
    "mongodb": "^6.8.0",
    "typescript": "4.7.4"
  },
  "dependencies": {
    "@koa/router": "12.0.1",
    "@types/koa": "2.13.12",
    "@types/koa__router": "12.0.4",
    "jsonwebtoken": "^9.0.2",
    "koa": "2.14.2",
    "koa-body": "6.0.1",
    "yaml": "^2.5.0"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    }
  },
  "peerDependencies": {
    "mongodb": "^6.8.0"
  }
}